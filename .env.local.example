# Cloudflare Worker URL (set after running `npx wrangler deploy` inside cf-worker/)
# The worker holds GEMINI_API_KEY as a secret — it must NOT be set here.
VITE_WORKER_URL=https://edrai-gemini-proxy.YOUR_SUBDOMAIN.workers.dev

# Webhook del chatbot del Mercado del Barranco (demo "Integración real")
# Si se deja vacío, el demo muestra un aviso amable en lugar de fallar.
VITE_N8N_WEBHOOK_URL=

# ── Analítica (PostHog Cloud EU) ─────────────────────────────────────────────
# Project API Key: Settings → Project → Project API Key en eu.posthog.com.
# Es pública y de solo escritura (no permite leer datos), por eso viaja en el
# bundle sin problema. Si se deja vacía, la analítica queda desactivada.
VITE_POSTHOG_KEY=

# Host de ingesta. Vacío = https://eu.i.posthog.com (Cloud EU).
# Para esquivar bloqueadores: https://edrai-gemini-proxy.<subdominio>.workers.dev/ph
VITE_POSTHOG_HOST=

# 'cookieless' (por defecto): sin cookies, sin banner, sin session replay.
# 'consent': requiere banner de consentimiento previo. Ver docs/ANALITICA.md.
VITE_POSTHOG_MODE=cookieless
