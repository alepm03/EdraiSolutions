# Public endpoints (not secrets: they ship in the browser bundle).
# Cloudflare Worker URL (set after `npx wrangler deploy` inside cf-worker/).
# The worker holds GEMINI_API_KEY as a secret: it must NOT be set here.
PUBLIC_WORKER_URL=https://edrai-gemini-proxy.YOUR_SUBDOMAIN.workers.dev

# Real Mercado del Barranco agent (demo "Agente real"). Empty = production URL;
# in `npm run dev` the request goes through the /api/barranco proxy in astro.config.mjs.
PUBLIC_BARRANCO_API_URL=

# Analytics (PostHog Cloud EU). Public, write-only project key. Empty = analytics off.
PUBLIC_POSTHOG_KEY=
# Ingest host. Empty = https://eu.i.posthog.com. Optional Worker proxy: https://<worker>/ph
PUBLIC_POSTHOG_HOST=
# 'cookieless' (default): no cookies, no banner, no session replay. See docs/ANALITICA.md.
PUBLIC_POSTHOG_MODE=cookieless
