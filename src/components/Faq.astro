---
import { ChevronDown } from '@lucide/astro';
import { FAQ } from '../data/site';
---
<div class="faq" data-reveal>
  {FAQ.map((f) => (
    <details name="faq">
      <summary>{f.q}<ChevronDown /></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; max-width: 860px; border-bottom: 1px solid var(--line-strong); interpolate-size: allow-keywords; }
  details { border-top: 1px solid var(--line-strong); }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; font: 650 17px/1.35 var(--font-body); transition: color 0.2s; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--brand); }
  summary :global(svg) { width: 18px; height: 18px; flex: none; color: var(--muted); transition: transform 0.35s var(--ease-out); }
  details[open] summary :global(svg) { transform: rotate(180deg); color: var(--brand); }
  details p { padding: 0 40px 20px 0; color: var(--text-2); font-size: 15.5px; line-height: 1.6; max-width: 70ch; }
  /* Open and close by animating the real content height (no JS). */
  details::details-content { block-size: 0; overflow: clip; transition: block-size 0.4s var(--ease-out), content-visibility 0.4s allow-discrete; }
  details[open]::details-content { block-size: auto; }
  @media (prefers-reduced-motion: reduce) { details::details-content { transition: none; } }
</style>
