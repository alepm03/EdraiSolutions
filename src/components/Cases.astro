---
// Real clients (production ClientTestimonials, restyled). Barranco figures are
// the last full month from its agent database (MONTHLY in data/site.ts).
import { Scale, ArrowRight } from '@lucide/astro';
import { MONTHLY, TESTIMONIALS as T } from '../data/site';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const stats = [
  { v: String(MONTHLY.conversations), u: '', l: `conversaciones atendidas en ${MONTHLY.month.split(' ')[0]}` },
  { v: String(MONTHLY.messages), u: '', l: 'mensajes de clientes respondidos' },
  { v: MONTHLY.englishPct, u: '%', l: 'de las conversaciones, en inglés' },
  { v: MONTHLY.resolvedPct, u: '%', l: 'resueltas sin pasar al equipo' },
];
---
<div class:list={['cases', { compact }]}>
<figure class="case-main" data-reveal>
  <div class="case-quote">
    <blockquote>«{T.barranco.quote}»</blockquote>
    <figcaption>
      <img src={T.barranco.logo} alt="Logo de Mercado del Barranco" width="44" height="44" loading="lazy" />
      <div><b>{T.barranco.who}</b><span>{T.barranco.role}</span></div>
    </figcaption>
    {!compact && <a class="link-arrow" href="/casos/mercado-del-barranco">Ver el caso y probar su agente <ArrowRight /></a>}
  </div>
  <div class="case-stats">
    {stats.map((s) => (
      <div><b class="tabular">{s.v}<small>{s.u}</small></b><span>{s.l}</span></div>
    ))}
    <p class="case-src"><span class="live" aria-hidden="true"></span>Datos reales del agente, {MONTHLY.month}. Se actualizan cada mes.</p>
  </div>
</figure>

{!compact && (
  <div class="quotes">
    <figure data-reveal="1">
      <blockquote>«{T.ijump.quote}»</blockquote>
      <figcaption><img src={T.ijump.logo} alt="Logo de I Jump Skydive" width="40" height="40" loading="lazy" /><div><b>{T.ijump.who}</b><span>{T.ijump.role}</span></div></figcaption>
      <p class="q-what">{T.ijump.what}</p>
    </figure>
    <figure data-reveal="2">
      <blockquote>«{T.despacho.quote}»</blockquote>
      <figcaption><span class="q-ic"><Scale /></span><div><b>{T.despacho.who}</b><span>{T.despacho.role}</span></div></figcaption>
      <p class="q-what">{T.despacho.what}</p>
    </figure>
  </div>
)}
</div>

<style>
  /* Lead case on the left (quote over its four dated figures), the two other
     clients stacked on the right. Ruled, no boxes. */
  .cases { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
  .cases.compact { grid-template-columns: 1fr; }
  .case-main { display: grid; gap: clamp(20px, 3svh, 32px); padding-top: 22px; border-top: 2px solid var(--brand); }
  .compact .case-main { grid-template-columns: 1.1fr 1fr; gap: 48px; }
  .case-quote { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .case-quote blockquote { font: 650 clamp(1.25rem, 1rem + 0.9vw, 1.7rem)/1.35 var(--font-display); letter-spacing: -0.02em; text-wrap: pretty; max-width: 36ch; }
  figcaption { display: flex; align-items: center; gap: 12px; }
  figcaption img { border-radius: 8px; border: 1px solid var(--line-strong); }
  figcaption b { display: block; font-size: 14.5px; font-weight: 700; }
  figcaption span { font-size: 13px; color: var(--muted); }
  .case-quote .link-arrow { color: var(--brand); }
  .case-stats { display: grid; grid-template-columns: repeat(4, 1fr); column-gap: 24px; }
  .compact .case-stats { grid-template-columns: 1fr 1fr; align-content: start; }
  .case-stats > div { padding: 16px 0 14px; border-top: 1px solid var(--line-strong); display: grid; gap: 8px; align-content: start; }
  .case-stats b { font: 850 clamp(2.1rem, 1.5rem + 1.7vw, 3.2rem)/0.95 var(--font-display); letter-spacing: -0.045em; }
  .case-stats small { font-size: 0.55em; color: var(--brand); margin-left: 2px; }
  .case-stats span { font-size: 13.5px; color: var(--muted); line-height: 1.4; }
  .case-src { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; padding: 12px 0 0; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--faint); }
  .live { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); flex: none; }

  .quotes { display: grid; }
  .quotes figure { display: flex; flex-direction: column; gap: 14px; padding: 22px 0 24px; border-top: 1px solid var(--line-strong); }
  .quotes figure:last-child { padding-bottom: 0; }
  .quotes blockquote { font-size: 16px; line-height: 1.55; text-wrap: pretty; }
  .q-ic { width: 40px; height: 40px; border-radius: 8px; display: grid; place-items: center; background: var(--surface-2); border: 1px solid var(--line-strong); }
  .q-ic :global(svg) { width: 17px; height: 17px; }
  .q-what { font-size: 13.5px; color: var(--muted); }
  @media (min-width: 1025px) and (max-height: 820px) {
    .case-main { gap: 16px; padding-top: 16px; }
    .case-quote { gap: 12px; }
    .case-quote blockquote { font-size: 1.3rem; max-width: 44ch; }
    .case-stats b { font-size: 2.4rem; }
    .quotes figure { gap: 10px; padding: 16px 0 18px; }
    .quotes blockquote { font-size: 15px; }
  }
  @media (max-width: 960px) {
    .cases, .compact .case-main { grid-template-columns: 1fr; }
    .case-stats { grid-template-columns: 1fr 1fr; }
  }
</style>
