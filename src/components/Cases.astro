---
// Real clients (production ClientTestimonials, restyled). Barranco figures are
// the last full month from its agent database (MONTHLY in data/site.ts).
import { Scale, ArrowRight } from '@lucide/astro';
import { MONTHLY, TESTIMONIALS as T } from '../data/site';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const stats = [
  { v: String(MONTHLY.conversations), u: '', l: `conversaciones atendidas en ${MONTHLY.month.split(' ')[0]}` },
  { v: String(MONTHLY.messages), u: '', l: 'mensajes de clientes respondidos' },
  { v: MONTHLY.englishPct, u: '%', l: 'de las conversaciones, en inglés' },
  { v: MONTHLY.resolvedPct, u: '%', l: 'resueltas sin pasar al equipo' },
];
---
<figure class="card case-main" data-reveal>
  <div class="case-quote">
    <span class="qmark" aria-hidden="true">“</span>
    <blockquote>{T.barranco.quote}</blockquote>
    <figcaption>
      <img src={T.barranco.logo} alt="Logo de Mercado del Barranco" width="44" height="44" loading="lazy" />
      <div><b>{T.barranco.who}</b><span>{T.barranco.role}</span></div>
    </figcaption>
    {!compact && <a class="link-arrow" href="/casos/mercado-del-barranco">Ver el caso y probar su agente <ArrowRight /></a>}
  </div>
  <div class="case-stats">
    {stats.map((s) => (
      <div><b class="tabular">{s.v}<small>{s.u}</small></b><span>{s.l}</span></div>
    ))}
    <p class="case-src"><span class="live" aria-hidden="true"></span>Datos reales del agente, {MONTHLY.month}. Se actualizan cada mes.</p>
  </div>
</figure>

{!compact && (
  <div class="quotes">
    <figure class="card" data-reveal>
      <span class="qmark" aria-hidden="true">“</span>
      <blockquote>{T.ijump.quote}</blockquote>
      <figcaption><img src={T.ijump.logo} alt="Logo de I Jump Skydive" width="40" height="40" loading="lazy" /><div><b>{T.ijump.who}</b><span>{T.ijump.role}</span></div></figcaption>
      <p class="q-what">{T.ijump.what}</p>
    </figure>
    <figure class="card" data-reveal="1">
      <span class="qmark" aria-hidden="true">“</span>
      <blockquote>{T.despacho.quote}</blockquote>
      <figcaption><span class="q-ic"><Scale /></span><div><b>{T.despacho.who}</b><span>{T.despacho.role}</span></div></figcaption>
      <p class="q-what">{T.despacho.what}</p>
    </figure>
  </div>
)}

<style>
  .case-main { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; padding: clamp(24px, 4vw, 48px); border-color: rgba(34, 211, 238, 0.22); background: linear-gradient(135deg, rgba(34, 211, 238, 0.07), rgba(255, 255, 255, 0.025) 55%); }
  .case-quote { display: flex; flex-direction: column; gap: 22px; }
  .qmark { font: 800 64px/0.6 var(--font-display); color: rgba(34, 211, 238, 0.6); height: 26px; }
  .case-quote blockquote { font: 600 clamp(1.25rem, 1rem + 0.8vw, 1.6rem)/1.4 var(--font-display); letter-spacing: -0.02em; text-wrap: pretty; }
  figcaption { display: flex; align-items: center; gap: 12px; }
  figcaption img { border-radius: 12px; border: 1px solid var(--line-strong); }
  figcaption b { display: block; font-size: 14.5px; font-weight: 700; }
  figcaption span { font-size: 13px; color: var(--muted); }
  .case-quote .link-arrow { margin-top: auto; color: var(--brand); }
  .case-stats { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; align-content: start; }
  .case-stats > div { padding: 18px 0 20px; border-top: 1px solid var(--line-strong); display: grid; gap: 8px; align-content: start; }
  .case-stats b { font: 850 clamp(2.6rem, 1.9rem + 1.8vw, 3.6rem)/0.95 var(--font-display); letter-spacing: -0.045em; }
  .case-stats small { font-size: 0.55em; color: var(--brand); margin-left: 2px; }
  .case-stats span { font-size: 13.5px; color: var(--muted); line-height: 1.45; }
  .case-src { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; padding: 14px 0 0; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--faint); }
  .live { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); flex: none; }
  .quotes { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .quotes figure { display: flex; flex-direction: column; gap: 20px; padding: 28px; }
  .quotes blockquote { font-size: 17px; line-height: 1.55; text-wrap: pretty; }
  .q-ic { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--surface-2); border: 1px solid var(--line-strong); }
  .q-ic :global(svg) { width: 17px; height: 17px; }
  .q-what { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); font-size: 13.5px; color: var(--muted); }
  @media (max-width: 960px) { .case-main, .quotes { grid-template-columns: 1fr; } }
</style>
