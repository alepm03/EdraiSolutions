---
import Base from '../../layouts/Base.astro';
import Cases from '../../components/Cases.astro';
import ContactSection from '../../components/ContactSection.astro';
---
<Base title="Casos reales · Edrai Solutions" description="Negocios reales que ya trabajan con agentes de IA, software a medida y automatizaciones de Edrai Solutions, con sus números.">
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display page-h1">Casos <span class="hl">reales</span>.</h1>
      <p class="lede page-lede">Negocios con su nombre y sus números. Las cifras salen de la base de datos de cada agente y se actualizan cada mes.</p>
    </div>
  </section>
  <section class="section section-tight"><div class="wrap"><Cases /></div></section>
  <section class="section"><div class="wrap"><ContactSection /></div></section>
</Base>
