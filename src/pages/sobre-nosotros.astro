---
import Base from '../layouts/Base.astro';
import Team from '../components/Team.astro';
import Process from '../components/Process.astro';
import ContactSection from '../components/ContactSection.astro';
---
<Base title="Sobre nosotros · Edrai Solutions" description="Edrai Solutions es una agencia de IA de Madrid. Un equipo pequeño y técnico que diseña, construye y mantiene agentes, software y automatizaciones para pymes.">
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display page-h1">Una agencia que <span class="hl">construye</span>.</h1>
      <p class="lede page-lede">Agentes, software y automatizaciones hechos para un negocio concreto, con presupuesto cerrado, en producción en semanas y con soporte después. Desde Madrid, para pymes de toda España.</p>
    </div>
  </section>
  <section class="section section-tight"><div class="wrap"><div class="sec-head"><h2 class="h2">Hablas con <span class="hl">quien lo construye</span>.</h2><p class="lede">Quien hace el diagnóstico es quien después diseña y programa tu solución.</p></div><Team /></div></section>
  <section class="section section-tight"><div class="wrap"><div class="sec-head"><h2 class="h2">Cómo trabajamos.</h2><p class="lede">Validas cada paso antes de lanzar nada.</p></div><Process /></div></section>
  <section class="section"><div class="wrap"><ContactSection /></div></section>
</Base>
